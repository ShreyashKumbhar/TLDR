{
  "name": "devops-intern-otel-terraform-docker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src tests scripts && tsc --noEmit -p tsconfig.test.json",
    "test": "jest --runInBand --coverage",
    "test:container": "node --test tests/container.test.mjs",
    "test:network": "node scripts/check-plan.mjs && node --test tests/plan-policy.test.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@sentry/node": "11.0.0",
    "express": "5.2.1",
    "prom-client": "15.1.3",
    "winston": "3.19.0",
    "winston-transport": "4.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
